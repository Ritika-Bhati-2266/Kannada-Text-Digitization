# ==============================================================================
# OCR Engine Configuration
# Options: tesseract (default) | groq
# ==============================================================================
OCR_ENGINE=tesseract

# ==============================================================================
# 1. Groq Engine (OpenAI-compatible multimodal & text models)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Abort a transcription when more than this share of words is [illegible]
GROQ_MAX_TOKENS=4096
GROQ_MAX_ILLEGIBLE_RATIO=0.30

# ==============================================================================
# 2. Tesseract Offline OCR Engine (pytesseract + OpenCV)
# Optional: Set full path if tesseract is not in system PATH
# E.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# ==============================================================================
TESSERACT_CMD=
TESSDATA_PREFIX=
# Page segmentation mode passed to tesseract (4 = single column of text, 6 = single uniform block)
TESSERACT_PSM=6

# ==============================================================================
# Server & CORS Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
